{
  "name": "terrapulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/server.mjs",
    "dev:api": "node server/server.mjs",
    "dev:frontend": "vite",
    "test:brasil": "node scripts/test-brazil-quakes.mjs",
    "test:volcano": "node --experimental-strip-types scripts/test-volcano-risk.mjs",
    "test:periods": "node scripts/test-period-windows.mjs",
    "test:filters": "node --experimental-strip-types scripts/test-filter-visibility.mjs",
    "test:reports": "node scripts/test-report-interpretation.mjs",
    "test:precisao": "npm run test:volcano && npm run test:periods && npm run test:filters && npm run test:reports && npm run test:brasil && npm run test:volcano-pulse && npm run test:map-wrap",
    "test:volcano-pulse": "node --experimental-strip-types scripts/test-volcano-map-pulse.mjs",
    "test:map-wrap": "node scripts/test-map-world-wrap.mjs"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "maplibre-gl": "6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
